MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iskra_promo?retryWrites=true&w=majority
# Optional overrides. Staging otherwise derives /iskra_promo_staging automatically.
MONGODB_URI_live=
MONGODB_URI_staging=
PORT=4310
CLIENT_ORIGIN=http://localhost:5173,https://iskra.orvadora.com
JWT_SECRET=<64+ random chars, openssl rand -base64 64>
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_DATING_WEBHOOK_SECRET_staging=whsec_staging_dating_endpoint_replace_me
STRIPE_MEMBERSHIP_PRICE_ID=price_replace_me
# Production deployment sets STRIPE_MODE=live and selects these aliases first.
STRIPE_SECRET_KEY_live=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY_live=pk_live_replace_me
STRIPE_WEBHOOK_SECRET_live=whsec_live_endpoint_replace_me
STRIPE_DATING_WEBHOOK_SECRET_live=whsec_live_dating_endpoint_replace_me
STRIPE_MEMBERSHIP_PRICE_ID_live=price_live_replace_me
RESEND_API_KEY=re_replace_me
RESEND_FROM=Project ISKRA <noreply@projekt-iskra.com>
RATE_LIMIT_MAX=300
WRITE_RATE_LIMIT_MAX=30
SCANNER_SECRET=<64 hex chars, openssl rand -hex 32>
SCANNER_PASSCODE=<8+ chars, shared with door staff, NOT the admin password>
VISITOR_SIGNING_SECRET=<64 hex chars, openssl rand -hex 32>
CUSTOM_ORDER_ENCRYPTION_SECRET=<64 hex chars, openssl rand -hex 32>
ACCOUNT_AUTH_RATE_LIMIT_MAX=12
ACCOUNT_REGISTER_RATE_LIMIT_MAX=10
PROMO_RATE_LIMIT_MAX=60
CUSTOM_ORDER_RATE_LIMIT_MAX=30
