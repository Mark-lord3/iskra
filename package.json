{
  "name": "iskra-promo",
  "version": "1.0.0",
  "private": true,
  "description": "ISKRA — nightclub promo site (React + Node + MongoDB)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "deploy:staging": "./deploy-staging.sh",
    "deploy:production": "./deploy-production.sh",
    "deploy:dating:staging": "npm run deploy:staging --prefix iskra-app",
    "deploy:dating:production": "npm run deploy:production --prefix iskra-app"
  },
  "devDependencies": { "concurrently": "^9.1.0" }
}
